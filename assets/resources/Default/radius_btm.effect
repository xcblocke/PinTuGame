CCEffect %{
  techniques:
  - passes: 
      - blendState: 
          targets: 
            - blend: true
        rasterizerState: 
          cullMode: 0
        properties: 
          texture: { value: "white" }
          alphaThreshold: { value: 0.5 }
          borderColor: { value: [ 0, 0, 0, 1 ], editor: { type: "color" } }
          borderWidth: { value: 0.03 }
          borderRadius: { value: 0.095 }
          aspectRatio: { value: 2 }
        vert: vs
        frag: fs
}%

CCProgram vs %{
#include <cc-global>
#include <cc-local>
precision highp float;


attribute vec3 a_position;
attribute vec4 a_color;
varying vec4 v_color;
#if USE_TEXTURE
attribute vec2 a_uv0;
varying vec2 v_uv0;
#endif
void main () {
  vec4 pos = vec4(a_position, 1);
  #if CC_USE_MODEL
  pos = cc_matViewProj * cc_matWorld * pos;
  #else
  pos = cc_matViewProj * pos;
  #endif
  #if USE_TEXTURE
  v_uv0 = a_uv0;
  #endif
  v_color = a_color;
  gl_Position = pos;
}
}%


CCProgram fs %{

precision highp float;
#if USE_ALPHA_TEST
  uniform a0 {
 float alphaThreshold;
};
#endif
void ALPHA_TEST (in vec4 color) {
  #if USE_ALPHA_TEST
      if (color.a < alphaThreshold) discard;
  #endif
}
void ALPHA_TEST (in float alpha) {
  #if USE_ALPHA_TEST
      if (alpha < alphaThreshold) discard;
  #endif
}
varying vec4 v_color;
#if USE_TEXTURE
varying vec2 v_uv0;
uniform sampler2D texture;
#endif
uniform a2 {
 vec4 borderColor;
};
uniform a3 {
 float borderWidth;
};
uniform a4 {
 float borderRadius;
};
uniform a5 {
 float aspectRatio;
};
float roundedRect(vec2 uv, vec2 center, float radius) {
  vec2 uvClone = uv;
  uvClone.y *= aspectRatio;
  vec2 dis =  abs(uvClone - center);
  vec2 dist = dis - (center - radius);
  return length(max(dist, 0.0)) - radius;
}
void main () {
  vec4 o = vec4(1, 1, 1, 1);
  vec4 texture_tmp = texture2D(texture, v_uv0);
  #if CC_USE_ALPHA_ATLAS_texture
      texture_tmp.a *= texture2D(texture, v_uv0 + vec2(0, 0.5)).r;
  #endif
  #if INPUT_IS_GAMMA
    o.rgb *= (texture_tmp.rgb * texture_tmp.rgb);
    o.a *= texture_tmp.a;
  #else
    o *= texture_tmp;
  #endif
  o *= v_color;
  if(v_uv0.x < borderWidth) {
      o = borderColor;
  }
  if(v_uv0.x > 1.0 - borderWidth + 0.01) {
      o = borderColor;
  }
  if(v_uv0.y < borderWidth / aspectRatio) {
      o = borderColor;
  }
  if(v_uv0.y > 1.0 - borderWidth / aspectRatio) {
      o = borderColor;
  }
  vec2 uvCenter = vec2(0.5, 0.5 * aspectRatio);
  float rectDist = roundedRect(v_uv0, uvCenter, borderRadius);
  float dis = 0.01;
  if (rectDist > dis) {
    discard;
  }
  if(abs(rectDist) < borderWidth ) {
      o = borderColor;
  }
  if (rectDist < dis && rectDist > 0.0) {
      o = borderColor;
      o.a = (dis - rectDist) / dis;
  }
  ALPHA_TEST(o);
  gl_FragColor = o.rgba;
}
}%