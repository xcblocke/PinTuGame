      "glsl1": {
        "vert": "uniform mat4 cc_matViewProj;\nuniform mat4 cc_matWorld;\nprecision highp float;\nattribute vec3 a_position;\nattribute vec4 a_color;\nvarying vec4 v_color;\n#if USE_TEXTURE\nattribute vec2 a_uv0;\nvarying vec2 v_uv0;\n#endif\nvoid main () {\n  vec4 pos = vec4(a_position, 1);\n  #if CC_USE_MODEL\n  pos = cc_matViewProj * cc_matWorld * pos;\n  #else\n  pos = cc_matViewProj * pos;\n  #endif\n  #if USE_TEXTURE\n  v_uv0 = a_uv0;\n  #endif\n  v_color = a_color;\n  gl_Position = pos;\n}",
        "frag": "\n#ifdef GL_OES_standard_derivatives\n#extension GL_OES_standard_derivatives : enable\n#endif\nprecision highp float;\n#if USE_ALPHA_TEST\n  uniform float alphaThreshold;\n#endif\nvoid ALPHA_TEST (in vec4 color) {\n  #if USE_ALPHA_TEST\n      if (color.a < alphaThreshold) discard;\n  #endif\n}\nvoid ALPHA_TEST (in float alpha) {\n  #if USE_ALPHA_TEST\n      if (alpha < alphaThreshold) discard;\n  #endif\n}\nvarying vec4 v_color;\n#if USE_TEXTURE\nvarying vec2 v_uv0;\nuniform sampler2D texture;\n#endif\nuniform vec4 borderColor;\nuniform float borderWidth;\nuniform float blackBorderWidth;\nuniform float borderScale;\nuniform float borderRadius;\nuniform float aspectRatio;\nuniform float maxRow;\nuniform float maxCol;\nfloat roundedRect(vec2 uv, vec2 center, float radius) {\n    vec2 uvClone = uv;\n    uvClone.y *= aspectRatio;\n    vec2 dis = abs(uvClone - center);\n    vec2 dist = dis - (center - radius);\n    return length(max(dist, 0.0)) - radius;\n}\nfloat bit_and(float x, float y) {\n    float result = 0.0;\n    float bit = 1.0;\n    for (int i = 0; i < 8; i++) {\n        float x_bit = mod(floor(x / bit), 2.0);\n        float y_bit = mod(floor(y / bit), 2.0);\n        result += x_bit * y_bit * bit;\n        bit *= 2.0;\n    }\n    return result;\n}\nvoid main () {\n    vec4 o = vec4(1, 1, 1, 1);\n    vec4 color = v_color;\n    float row = floor(color.r * 255.0);\n    float col = floor(color.g * 255.0);\n    float flag = floor(color.b * 255.0);\n    float flag2 = floor(color.a * 255.0);\n    vec2 startPos = vec2(row / maxRow, col / maxCol);\n    vec2 endPos = vec2((row + 1.0) / maxRow,(col + 1.0) / maxCol);\n    vec2 simpeUv = startPos + v_uv0 * (endPos - startPos);\n    vec2 duv = fwidth(v_uv0);\n    float bw = borderWidth * borderScale;\n    float bbw = blackBorderWidth * borderScale;\n    float borderWidthU = bw * duv.x;\n    float borderWidthV = bw * duv.y;\n    float blackBorderWidthU = bbw * duv.x;\n    float blackBorderWidthV = bbw * duv.y;\n    float alhpaa = 0.3;\n  vec4 texture_tmp = texture2D(texture, simpeUv);\n  #if CC_USE_ALPHA_ATLAS_texture\n      texture_tmp.a *= texture2D(texture, simpeUv + vec2(0, 0.5)).r;\n  #endif\n  #if INPUT_IS_GAMMA\n    o.rgb *= (texture_tmp.rgb * texture_tmp.rgb);\n    o.a *= texture_tmp.a;\n  #else\n    o *= texture_tmp;\n  #endif\n    vec4 originColor = o;\n    vec4 blendColor = borderColor * 0.8 + originColor * 0.2;\n    vec4 blackBlendColor = vec4(0.0, 0.0, 0.0, alhpaa);\n    vec4 showBorder = vec4(0.0, 0.0, 0.0, 0.0);\n    vec4 showBorder2 = vec4(0.0, 0.0, 0.0, 0.0);\n    showBorder2.x = bit_and(flag, 128.0) > 0.0 ? 1.0 : 0.0;\n    showBorder2.y = bit_and(flag, 64.0) > 0.0 ? 1.0 : 0.0;\n    showBorder2.z = bit_and(flag, 32.0) > 0.0 ? 1.0 : 0.0;\n    showBorder2.w = bit_and(flag, 16.0) > 0.0 ? 1.0 : 0.0;\n    showBorder.x = bit_and(flag, 8.0) > 0.0 ? 1.0 : 0.0;\n    showBorder.y = bit_and(flag, 4.0) > 0.0 ? 1.0 : 0.0;\n    showBorder.z = bit_and(flag, 2.0) > 0.0 ? 1.0 : 0.0;\n    showBorder.w = bit_and(flag, 1.0) > 0.0 ? 1.0 : 0.0;\n    if(showBorder2.x == 1.0 && v_uv0.x < borderWidthU && v_uv0.y < borderWidthV) {\n        o = blendColor;\n        if(v_uv0.x < blackBorderWidthU && v_uv0.y < blackBorderWidthV) {\n            o = blackBlendColor;\n        }\n    }\n    if(showBorder2.y == 1.0 && v_uv0.x > 1.0 - borderWidthU && v_uv0.y < borderWidthV) {\n        o = blendColor;\n        if(v_uv0.x > 1.0 - blackBorderWidthU && v_uv0.y < blackBorderWidthV) {\n            o = blackBlendColor;\n        }\n    }\n    if(showBorder2.z == 1.0 && v_uv0.x < borderWidthU && v_uv0.y > 1.0 - borderWidthV) {\n        o = blendColor;\n        if(v_uv0.x < blackBorderWidthU && v_uv0.y > 1.0 - blackBorderWidthV) {\n            o = blackBlendColor;\n        }\n    }\n    if(showBorder2.w == 1.0 && v_uv0.x > 1.0 - borderWidthU && v_uv0.y > 1.0 - borderWidthV) {\n        o = blendColor;\n        if(v_uv0.x > 1.0 - blackBorderWidthU && v_uv0.y > 1.0 - blackBorderWidthV) {\n            o = blackBlendColor;\n        }\n    }\n    if(showBorder.z == 1.0 && v_uv0.x < borderWidthU) {\n        o = blendColor;\n        if(v_uv0.x < blackBorderWidthU) {\n            o = blackBlendColor;\n        }\n    }\n    if(showBorder.w == 1.0 && v_uv0.x > 1.0 - borderWidthU) {\n        o = blendColor;\n        if(v_uv0.x > 1.0 - blackBorderWidthU) {\n            o = blackBlendColor;\n        }\n    }\n    if(showBorder.x == 1.0 && v_uv0.y < borderWidthV) {\n        if(o.a != alhpaa) {\n            o = blendColor;\n        }\n        if(v_uv0.y < blackBorderWidthV) {\n            o = blackBlendColor;\n        }\n    }\n    if(showBorder.y == 1.0 && v_uv0.y > 1.0 - borderWidthV) {\n        if(o.a != alhpaa) {\n            o = blendColor;\n        }\n        if(v_uv0.y > 1.0 - blackBorderWidthV) {\n            o = blackBlendColor;\n        }\n    }\n    bool leftTopRadius = showBorder.y == 1.0 && showBorder.z == 1.0;\n    bool rightTopRadius = showBorder.y == 1.0 && showBorder.w == 1.0;\n    bool leftBottomRadius = showBorder.x == 1.0 && showBorder.z == 1.0;\n    bool rightBottomRadius = showBorder.x == 1.0 && showBorder.w == 1.0;\n    if((v_uv0.x < 0.5 && v_uv0.y < 0.5 && leftBottomRadius == true)\n        || (v_uv0.x > 0.5 && v_uv0.y > 0.5 && rightTopRadius == true)\n        || (v_uv0.x < 0.5 && v_uv0.y > 0.5 && leftTopRadius == true)\n        || (v_uv0.x > 0.5 && v_uv0.y < 0.5 && rightBottomRadius == true)) {\n        vec2 center = vec2(0.5, 0.5 * aspectRatio);\n        float rectDist = roundedRect(v_uv0, center, borderRadius);\n        float aa = max(fwidth(rectDist), 1e-6);\n        float bwCorner = bw * min(duv.x, duv.y * aspectRatio);\n        float bbwCorner = bbw * min(duv.x, duv.y * aspectRatio);\n        bool isShowBorder = true;\n        if(abs(rectDist) < bwCorner) {\n            o = borderColor * 0.8 + originColor * 0.2;\n        }\n        if(abs(rectDist) < bbwCorner) {\n            o = vec4(0.0, 0.0, 0.0, alhpaa);\n        }\n        if (rectDist < aa && rectDist > 0.0) {\n            o = vec4(0.0, 0.0, 0.0, (aa - rectDist) / aa * alhpaa);\n        }\n        if (rectDist > aa) {\n            o.a = 0.0;\n        }\n    }\n    ALPHA_TEST(o);\n    gl_FragColor = o.rgba;\n}"
