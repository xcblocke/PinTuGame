        "vert": "uniform mat4 cc_matViewProj;\nuniform mat4 cc_matWorld;\nprecision highp float;\nattribute vec3 a_position;\nattribute vec4 a_color;\nvarying vec4 v_color;\n#if USE_TEXTURE\nattribute vec2 a_uv0;\nvarying vec2 v_uv0;\n#endif\nvoid main () {\n  vec4 pos = vec4(a_position, 1);\n  #if CC_USE_MODEL\n  pos = cc_matViewProj * cc_matWorld * pos;\n  #else\n  pos = cc_matViewProj * pos;\n  #endif\n  #if USE_TEXTURE\n  v_uv0 = a_uv0;\n  #endif\n  v_color = a_color;\n  gl_Position = pos;\n}",
        "frag": "\nprecision highp float;\n#if USE_ALPHA_TEST\n  uniform float alphaThreshold;\n#endif\nvoid ALPHA_TEST (in vec4 color) {\n  #if USE_ALPHA_TEST\n      if (color.a < alphaThreshold) discard;\n  #endif\n}\nvoid ALPHA_TEST (in float alpha) {\n  #if USE_ALPHA_TEST\n      if (alpha < alphaThreshold) discard;\n  #endif\n}\nvarying vec4 v_color;\n#if USE_TEXTURE\nvarying vec2 v_uv0;\nuniform sampler2D texture;\n#endif\nuniform vec4 borderColor;\nuniform float borderWidth;\nuniform float borderRadius;\nuniform float aspectRatio;\nfloat roundedRect(vec2 uv, vec2 center, float radius) {\n  vec2 uvClone = uv;\n  uvClone.y *= aspectRatio;\n  vec2 dis =  abs(uvClone - center);\n  vec2 dist = dis - (center - radius);\n  return length(max(dist, 0.0)) - radius;\n}\nvoid main () {\n  vec4 o = vec4(1, 1, 1, 1);\n  vec4 texture_tmp = texture2D(texture, v_uv0);\n  #if CC_USE_ALPHA_ATLAS_texture\n      texture_tmp.a *= texture2D(texture, v_uv0 + vec2(0, 0.5)).r;\n  #endif\n  #if INPUT_IS_GAMMA\n    o.rgb *= (texture_tmp.rgb * texture_tmp.rgb);\n    o.a *= texture_tmp.a;\n  #else\n    o *= texture_tmp;\n  #endif\n  o *= v_color;\n  if(v_uv0.x < borderWidth) {\n      o = borderColor;\n  }\n  if(v_uv0.x > 1.0 - borderWidth + 0.01) {\n      o = borderColor;\n  }\n  if(v_uv0.y < borderWidth / aspectRatio) {\n      o = borderColor;\n  }\n  if(v_uv0.y > 1.0 - borderWidth / aspectRatio) {\n      o = borderColor;\n  }\n  vec2 uvCenter = vec2(0.5, 0.5 * aspectRatio);\n  float rectDist = roundedRect(v_uv0, uvCenter, borderRadius);\n  float dis = 0.01;\n  if (rectDist > dis) {\n    discard;\n  }\n  if(abs(rectDist) < borderWidth ) {\n      o = borderColor;\n  }\n  if (rectDist < dis && rectDist > 0.0) {\n      o = borderColor;\n      o.a = (dis - rectDist) / dis;\n  }\n  ALPHA_TEST(o);\n  gl_FragColor = o.rgba;\n}"
