CCEffect %{
  techniques:
  - passes: 
      - blendState: 
          targets: 
            - blend: true
        rasterizerState: 
          cullMode: 0
        properties: 
          texture: { value: "white" }
          alphaThreshold: { value: 0.5 }
          borderColor: { value: [ 1, 1, 1, 1 ], editor: { type: "color" } }
          borderWidth: { value: 3 }
          blackBorderWidth: { value: 1 }
          borderScale: { value: 1 }
          borderRadius: { value: 0.095 }
          aspectRatio: { value: 2 }
          maxRow: { value: 1 }
          maxCol: { value: 1 }
        vert: vs
        frag: fs
}%

CCProgram vs %{
#include <cc-global>
#include <cc-local>
precision highp float;


attribute vec3 a_position;
attribute vec4 a_color;
varying vec4 v_color;
#if USE_TEXTURE
attribute vec2 a_uv0;
varying vec2 v_uv0;
#endif
void main () {
  vec4 pos = vec4(a_position, 1);
  #if CC_USE_MODEL
  pos = cc_matViewProj * cc_matWorld * pos;
  #else
  pos = cc_matViewProj * pos;
  #endif
  #if USE_TEXTURE
  v_uv0 = a_uv0;
  #endif
  v_color = a_color;
  gl_Position = pos;
}
}%


CCProgram fs %{

#ifdef GL_OES_standard_derivatives
#extension GL_OES_standard_derivatives : enable
#endif
precision highp float;
#if USE_ALPHA_TEST
  uniform a0 {
 float alphaThreshold;
};
#endif
void ALPHA_TEST (in vec4 color) {
  #if USE_ALPHA_TEST
      if (color.a < alphaThreshold) discard;
  #endif
}
void ALPHA_TEST (in float alpha) {
  #if USE_ALPHA_TEST
      if (alpha < alphaThreshold) discard;
  #endif
}
varying vec4 v_color;
#if USE_TEXTURE
varying vec2 v_uv0;
uniform sampler2D texture;
#endif
uniform a2 {
 vec4 borderColor;
};
uniform a3 {
 float borderWidth;
};
uniform a4 {
 float blackBorderWidth;
};
uniform a5 {
 float borderScale;
};
uniform a6 {
 float borderRadius;
};
uniform a7 {
 float aspectRatio;
};
uniform a8 {
 float maxRow;
};
uniform a9 {
 float maxCol;
};
float roundedRect(vec2 uv, vec2 center, float radius) {
    vec2 uvClone = uv;
    uvClone.y *= aspectRatio;
    vec2 dis = abs(uvClone - center);
    vec2 dist = dis - (center - radius);
    return length(max(dist, 0.0)) - radius;
}
float bit_and(float x, float y) {
    float result = 0.0;
    float bit = 1.0;
    for (int i = 0; i < 8; i++) {
        float x_bit = mod(floor(x / bit), 2.0);
        float y_bit = mod(floor(y / bit), 2.0);
        result += x_bit * y_bit * bit;
        bit *= 2.0;
    }
    return result;
}
void main () {
    vec4 o = vec4(1, 1, 1, 1);
    vec4 color = v_color;
    float row = floor(color.r * 255.0);
    float col = floor(color.g * 255.0);
    float flag = floor(color.b * 255.0);
    float flag2 = floor(color.a * 255.0);
    vec2 startPos = vec2(row / maxRow, col / maxCol);
    vec2 endPos = vec2((row + 1.0) / maxRow,(col + 1.0) / maxCol);
    vec2 simpeUv = startPos + v_uv0 * (endPos - startPos);
    vec2 duv = fwidth(v_uv0);
    float bw = borderWidth * borderScale;
    float bbw = blackBorderWidth * borderScale;
    float borderWidthU = bw * duv.x;
    float borderWidthV = bw * duv.y;
    float blackBorderWidthU = bbw * duv.x;
    float blackBorderWidthV = bbw * duv.y;
    float alhpaa = 0.3;
  vec4 texture_tmp = texture2D(texture, simpeUv);
  #if CC_USE_ALPHA_ATLAS_texture
      texture_tmp.a *= texture2D(texture, simpeUv + vec2(0, 0.5)).r;
  #endif
  #if INPUT_IS_GAMMA
    o.rgb *= (texture_tmp.rgb * texture_tmp.rgb);
    o.a *= texture_tmp.a;
  #else
    o *= texture_tmp;
  #endif
    vec4 originColor = o;
    vec4 blendColor = borderColor * 0.8 + originColor * 0.2;
    vec4 blackBlendColor = vec4(0.0, 0.0, 0.0, alhpaa);
    vec4 showBorder = vec4(0.0, 0.0, 0.0, 0.0);
    vec4 showBorder2 = vec4(0.0, 0.0, 0.0, 0.0);
    showBorder2.x = bit_and(flag, 128.0) > 0.0 ? 1.0 : 0.0;
    showBorder2.y = bit_and(flag, 64.0) > 0.0 ? 1.0 : 0.0;
    showBorder2.z = bit_and(flag, 32.0) > 0.0 ? 1.0 : 0.0;
    showBorder2.w = bit_and(flag, 16.0) > 0.0 ? 1.0 : 0.0;
    showBorder.x = bit_and(flag, 8.0) > 0.0 ? 1.0 : 0.0;
    showBorder.y = bit_and(flag, 4.0) > 0.0 ? 1.0 : 0.0;
    showBorder.z = bit_and(flag, 2.0) > 0.0 ? 1.0 : 0.0;
    showBorder.w = bit_and(flag, 1.0) > 0.0 ? 1.0 : 0.0;
    if(showBorder2.x == 1.0 && v_uv0.x < borderWidthU && v_uv0.y < borderWidthV) {
        o = blendColor;
        if(v_uv0.x < blackBorderWidthU && v_uv0.y < blackBorderWidthV) {
            o = blackBlendColor;
        }
    }
    if(showBorder2.y == 1.0 && v_uv0.x > 1.0 - borderWidthU && v_uv0.y < borderWidthV) {
        o = blendColor;
        if(v_uv0.x > 1.0 - blackBorderWidthU && v_uv0.y < blackBorderWidthV) {
            o = blackBlendColor;
        }
    }
    if(showBorder2.z == 1.0 && v_uv0.x < borderWidthU && v_uv0.y > 1.0 - borderWidthV) {
        o = blendColor;
        if(v_uv0.x < blackBorderWidthU && v_uv0.y > 1.0 - blackBorderWidthV) {
            o = blackBlendColor;
        }
    }
    if(showBorder2.w == 1.0 && v_uv0.x > 1.0 - borderWidthU && v_uv0.y > 1.0 - borderWidthV) {
        o = blendColor;
        if(v_uv0.x > 1.0 - blackBorderWidthU && v_uv0.y > 1.0 - blackBorderWidthV) {
            o = blackBlendColor;
        }
    }
    if(showBorder.z == 1.0 && v_uv0.x < borderWidthU) {
        o = blendColor;
        if(v_uv0.x < blackBorderWidthU) {
            o = blackBlendColor;
        }
    }
    if(showBorder.w == 1.0 && v_uv0.x > 1.0 - borderWidthU) {
        o = blendColor;
        if(v_uv0.x > 1.0 - blackBorderWidthU) {
            o = blackBlendColor;
        }
    }
    if(showBorder.x == 1.0 && v_uv0.y < borderWidthV) {
        if(o.a != alhpaa) {
            o = blendColor;
        }
        if(v_uv0.y < blackBorderWidthV) {
            o = blackBlendColor;
        }
    }
    if(showBorder.y == 1.0 && v_uv0.y > 1.0 - borderWidthV) {
        if(o.a != alhpaa) {
            o = blendColor;
        }
        if(v_uv0.y > 1.0 - blackBorderWidthV) {
            o = blackBlendColor;
        }
    }
    bool leftTopRadius = showBorder.y == 1.0 && showBorder.z == 1.0;
    bool rightTopRadius = showBorder.y == 1.0 && showBorder.w == 1.0;
    bool leftBottomRadius = showBorder.x == 1.0 && showBorder.z == 1.0;
    bool rightBottomRadius = showBorder.x == 1.0 && showBorder.w == 1.0;
    if((v_uv0.x < 0.5 && v_uv0.y < 0.5 && leftBottomRadius == true)
        || (v_uv0.x > 0.5 && v_uv0.y > 0.5 && rightTopRadius == true)
        || (v_uv0.x < 0.5 && v_uv0.y > 0.5 && leftTopRadius == true)
        || (v_uv0.x > 0.5 && v_uv0.y < 0.5 && rightBottomRadius == true)) {
        vec2 center = vec2(0.5, 0.5 * aspectRatio);
        float rectDist = roundedRect(v_uv0, center, borderRadius);
        float aa = max(fwidth(rectDist), 1e-6);
        float bwCorner = bw * min(duv.x, duv.y * aspectRatio);
        float bbwCorner = bbw * min(duv.x, duv.y * aspectRatio);
        bool isShowBorder = true;
        if(abs(rectDist) < bwCorner) {
            o = borderColor * 0.8 + originColor * 0.2;
        }
        if(abs(rectDist) < bbwCorner) {
            o = vec4(0.0, 0.0, 0.0, alhpaa);
        }
        if (rectDist < aa && rectDist > 0.0) {
            o = vec4(0.0, 0.0, 0.0, (aa - rectDist) / aa * alhpaa);
        }
        if (rectDist > aa) {
            o.a = 0.0;
        }
    }
    ALPHA_TEST(o);
    gl_FragColor = o.rgba;
}
}%